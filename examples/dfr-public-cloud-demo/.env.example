# ==== 后端服务端口 ====
PORT=3000

# ==== 配置加密密钥（用于加密落盘的 MinIO secretKey，生产必须改）====
DFR_CONFIG_SECRET=change-me-in-production

# ==== 直播/推流服务器对外地址（可选，留空则用请求 host 推断）====
# PUBLIC_SERVER_HOST=your-stream-host:port

# ---------------------------------------------------------------
# 说明：
# 司空 2 的 X-User-Token（组织密钥）、X-Project-Uuid、workflow、
# MinIO / MQTT / 推流 等运行时参数，不放在 .env，而是启动后在
# 前端「配置设置」页填写（会按用户维度加密存储在 backend/data/）。
# 获取组织密钥路径：司空 2 → 我的组织 → 组织设置 → OpenAPI → 复制密钥。
# ---------------------------------------------------------------
